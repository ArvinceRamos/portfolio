# Copy to .env.local for local dev, and add the same keys in Vercel → Project → Settings → Environment Variables.

# Your public site URL (used for SEO, sitemap and social previews)
NEXT_PUBLIC_SITE_URL=https://arvinceramos.vercel.app

# Contact form email (free tier at https://resend.com)
RESEND_API_KEY=
# Where contact messages are delivered (defaults to the email in src/content/profile.ts)
CONTACT_TO_EMAIL=
# Sender. Leave empty to use Resend's test sender (only delivers to your Resend account email).
CONTACT_FROM_EMAIL=
